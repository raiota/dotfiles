{
  "env": {
    "EDITOR": "nvim -n +let&awa=1 +startinsert",
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "0",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "CLAUDE_CODE_IDE_SKIP_VALID_CHECK": "1",
    "FORCE_AUTOUPDATE_PLUGINS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(emmylua_check)",
      "Bash(gh pr view)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(herdr agent get:*)",
      "Bash(herdr agent list:*)",
      "Bash(herdr agent prompt:*)",
      "Bash(herdr agent read:*)",
      "Bash(herdr agent start:*)",
      "Bash(herdr agent wait:*)",
      "Bash(herdr pane current:*)",
      "Bash(herdr pane get:*)",
      "Bash(herdr pane layout:*)",
      "Bash(herdr pane list:*)",
      "Bash(herdr pane read:*)",
      "Bash(herdr pane split:*)",
      "Bash(herdr status:*)",
      "Bash(herdr tab list:*)",
      "Bash(herdr workspace list:*)",
      "Bash(herdr worktree create:*)",
      "Bash(herdr worktree list:*)",
      "Bash(mkdir:*)",
      "Read(~/.config/git/message)",
      "Read(**/.env.sample)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:github.com)",
      "Edit(//private/tmp/**)",
      "Edit(**/.env.sample)",
      "mcp__plugin_context7_context7",
      "mcp__plugin_voicevox_voicevox__speak"
    ],
    "deny": [
      "Bash(chmod 777:*)",
      "Bash(gh repo delete:*)",
      "Bash(mongod:*)",
      "Bash(mysql:*)",
      "Bash(nc:*)",
      "Bash(psql:*)",
      "Bash(sudo:*)",
      "Bash(wget:*)",
      "Read(**/*.env*)",
      "Read(!**/.env.sample)",
      "Read(**/*aws*)",
      "Read(**/*key)",
      "Read(**/*token*)",
      "Read(**/*secrets*)",
      "Read(**/*production*)",
      "Read(~/.ssh/**)",
      "Edit(**/*.env*)",
      "Edit(!**/.env.sample)",
      "Edit(**/*aws*)",
      "Edit(**/*key)",
      "Edit(**/*production*)",
      "Edit(**/*secrets*)",
      "Edit(**/*token*)",
      "Edit(~/.ssh/**)",
      "mcp__supabase__execute_sql"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(git checkout:*)",
      "Bash(git config:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git rm:*)",
      "Bash(git switch:*)",
      "Bash(herdr agent send-keys:*)",
      "Bash(herdr pane close:*)",
      "Bash(herdr pane run:*)",
      "Bash(herdr pane send-keys:*)",
      "Bash(herdr pane send-text:*)",
      "Bash(herdr server stop:*)",
      "Bash(herdr tab close:*)",
      "Bash(herdr workspace close:*)",
      "Bash(herdr worktree remove:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "gh *",
      "docker *",
      "herdr *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "~/Library/pnpm/store",
        "~/Library/Caches/pnpm",
        "~/.bun/install/cache",
        "~/go/pkg/mod",
        "~/Library/Caches/go-build",
        "~/.cache/uv",
        "~/.cargo/registry",
        "~/.cargo/git"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.config/claude/.claude.json",
          "mode": "deny"
        },
        {
          "path": "~/.config/claude/.claude.json.backup",
          "mode": "deny"
        },
        {
          "path": "~/.config/claude/backups",
          "mode": "deny"
        }
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "proxy.golang.org",
        "sum.golang.org",
        "index.crates.io",
        "static.crates.io"
      ]
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.config/claude/hooks/notify.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.config/claude/hooks/stop.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.config/claude/statusline.sh"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "voicevox@raiota": true,
    "raiota-slides@raiota": true
  },
  "extraKnownMarketplaces": {
    "raiota": {
      "source": {
        "source": "github",
        "repo": "raiota/claude-plugins"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "Explanatory",
  "language": "ja"
}
