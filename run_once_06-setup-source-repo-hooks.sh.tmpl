#!/bin/bash
set -eu

# Use the hooks versioned in the chezmoi source repo (.githooks/), such as the
# gitleaks pre-commit scan. Safe to re-run; skipped when the source is not a git repo.
SOURCE_DIR={{ .chezmoi.sourceDir | quote }}

if git -C "$SOURCE_DIR" rev-parse --git-dir > /dev/null 2>&1; then
  git -C "$SOURCE_DIR" config core.hooksPath .githooks
fi

exit 0
