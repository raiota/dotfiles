#!/bin/bash
# mise のツールを config.toml と mise.lock のとおりに入れる。
#
# run_once_02 の mise install は最初の 1 回しか走らないので、別のマシンで更新した
# mise.lock が chezmoi update で届いても入らない。
#
# config.toml か mise.lock が変わったときだけ実行される:
# config.toml: {{ include "dot_config/mise/config.toml" | sha256sum }}
# mise.lock:   {{ include "dot_config/mise/private_mise.lock" | sha256sum }}

if ! command -v mise >/dev/null 2>&1; then
  echo "chezmoi: mise is not installed; skipped mise install" >&2
  exit 0
fi

# fish 以外から chezmoi を実行しても、pnpm がクールダウンの設定（~/.config/pnpm/config.yaml）を
# 読むように、config.fish と同じ場所を使う
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-{{ .chezmoi.homeDir }}/.config}"

mise install
