[alias]


[user]
    name = raiota
    email = 55177892+raiota@users.noreply.github.com

[includeIf "gitdir:~/repos/work/"]
    path = ~/repos/work/.gitconfig

[credential]
	helper = 
	helper = !gh auth git-credential

[core]
    editor = nvim
    filemode = true
    ignorecase = false
    pager = delta
    quotepath = false

[color]
    ui = true

[init]
    defaultBranch = main

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    features = catppuccin-macchiato
    side-by-side = true

[merge]
    conflictstyle = zdiff3

[safe]
    # Only use bare repos named explicitly (--git-dir / GIT_DIR). Stops an
    # embedded bare repo in a cloned tree from supplying config such as
    # core.fsmonitor to git commands that the prompt runs automatically.
    bareRepository = explicit

[ghq]
    root = ~/repos/ref

[ghq "https://github.com/raiota"]
    root = ~/repos/mine

[include]
    path = ~/.gitconfig.ghq
    path = ~/.config/delta/themes/catppuccin.gitconfig
